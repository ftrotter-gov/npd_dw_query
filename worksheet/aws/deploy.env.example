# Copy to worksheet/aws/deploy.env (git-ignored) and fill in. Used by render.sh,
# launch.sh, and stop.sh. NOTE: no PAT here — the PAT is entered in the dashboard
# at run time and never stored on AWS.

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=REPLACE_ME
AWS_REGION=us-east-1
ECS_CLUSTER=npd-east-prod-ecs-cluster

# Task networking — the same private subnets + SG the idr-extracts stack uses
# (they reach the Snowflake PrivateLink endpoint). assignPublicIp is DISABLED.
SUBNET_A=subnet-REPLACE_ME
SUBNET_B=subnet-REPLACE_ME
SUBNET_C=subnet-REPLACE_ME
SECURITY_GROUP=sg-REPLACE_ME

# ── Snowflake (non-secret config only) ────────────────────────────────────────
SNOWFLAKE_ACCOUNT=cms-idr.privatelink
SNOWFLAKE_USER=RHDM
SNOWFLAKE_ROLE=IDRSF_PAT_USER_P
SNOWFLAKE_WAREHOUSE=IDRC_PRD_COMM_WH

# ── Output ────────────────────────────────────────────────────────────────────
# S3_BUCKET is the DEFAULT output path shown in the UI; you can change it per run.
# S3_BUCKET_NAME is just the bucket (no prefix) — used to scope the task role.
S3_BUCKET=s3://REPLACE_ME/idr_worksheet/
S3_BUCKET_NAME=REPLACE_ME

# ── Behaviour ─────────────────────────────────────────────────────────────────
IDLE_SHUTDOWN_MINUTES=30

# ── Tunnel (SSM remote-host port-forward) ─────────────────────────────────────
# An SSM-managed EC2 instance in the SAME VPC to forward through. Discover with:
#   aws ec2 describe-instances --filters Name=vpc-id,Values=<vpc> \
#     Name=instance-state-name,Values=running \
#     --query 'Reservations[].Instances[?IamInstanceProfile].InstanceId' --output text
# then confirm it's SSM-managed:
#   aws ssm describe-instance-information --query "InstanceInformationList[].InstanceId"
SSM_BASTION_INSTANCE_ID=i-REPLACE_ME
LOCAL_PORT=8080
