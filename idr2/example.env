# IDR2 Orchestrator configuration (reference)
#
# These are the environment variables read by idr2/aws/orchestrator.py.
# NOTE: the orchestrator reads the PROCESS environment (os.environ) directly —
# it does NOT auto-load this file. Use it as a checklist: export the vars, put
# them in your ECS task definition, or `set -a; . idr2/.env; set +a` before a
# local run. Do NOT commit a real .env (it may hold a token).

# ── Snowflake connection ─────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=<SNOWFLAKE_ACCOUNT>
SNOWFLAKE_USER=<SNOWFLAKE_USER>
SNOWFLAKE_ROLE=<SNOWFLAKE_ROLE>
SNOWFLAKE_WAREHOUSE=<SNOWFLAKE_WAREHOUSE>
# SNOWFLAKE_DATABASE=          # optional session default
# SNOWFLAKE_SCHEMA=            # optional session default

# ── Auth — provide ONE. PAT is tried LOCAL-first, then AWS. ───────────────────
# Local laptop PAT (checked in this order), then AWS Secrets Manager fallback:
#   1. SNOWFLAKE_PAT / SNOWFLAKE_PASSWORD  (inline env, below)
#   2. SNOWFLAKE_PAT_FILE=/path/to/pat     (a file holding just the token)
#   3. ~/.config/idr2/snowflake_pat        (default file — picked up automatically)
#   4. SNOWFLAKE_PAT_SECRET_ID             (AWS Secrets Manager — the fallback)
# The default file at ~/.config/idr2/snowflake_pat needs NO env var at all.
# SNOWFLAKE_PAT=<your programmatic access token>   # inline — local testing only
# SNOWFLAKE_PAT_FILE=~/.config/idr2/snowflake_pat  # explicit local file override
# On AWS/Fargate (no local file), pull from Secrets Manager so no token is in the task def:
# SNOWFLAKE_PAT_SECRET_ID=arn:aws:secretsmanager:us-east-1:...:secret:idr-pat
# Key-pair fallback:
# SNOWFLAKE_PRIVATE_KEY_SECRET_ID=...
# SNOWFLAKE_PRIVATE_KEY_PATH=~/keys/idr_rsa.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ── Destination (S3) ─────────────────────────────────────────────────────────
# The container writes to S3 with the ECS task role; Snowflake unloads only to
# its internal @~/ user stage, so there is NO storage integration / stage to set.
S3_BUCKET=s3://<S3_BUCKET>/idr_bulk/
# SCRATCH_DIR=                 # GET landing dir; defaults to a temp dir on ephemeral disk

# ── Table list ───────────────────────────────────────────────────────────────
# TABLES_CSV=                  # defaults to idr2/step1_tables_to_export.csv

# ── Freshness / manual controls ──────────────────────────────────────────────
WATERMARK_COLUMN=IDR_UPDT_TS   # change-detection column (present in all IDR views)
# FORCE_EXPORT=1               # export everything, ignore skip logic
# ONLY_TABLES=npi_hstry,reasgnmt   # only tables whose name/stub contains these
