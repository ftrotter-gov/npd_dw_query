# IDR2 deploy variables — copy to deploy.env and fill in YOUR values.
#   cp idr2/aws/deploy.env.example idr2/aws/deploy.env
# deploy.env is git-ignored, so your account/network never get committed.
# Then render the AWS JSON:  ./idr2/aws/render.sh

# ── AWS (per person / per environment) ───────────────────────────────────────
AWS_ACCOUNT_ID=123456789012            # your AWS account id
AWS_REGION=us-east-1
ECS_CLUSTER=idr2-cluster
SUBNET_A=subnet-REPLACE_ME             # private subnet w/ IDR PrivateLink reach
SUBNET_B=subnet-REPLACE_ME
SECURITY_GROUP=sg-REPLACE_ME           # egress 443 to Snowflake + S3/ECR/logs

# ── Snowflake (SNOWFLAKE_USER is personal; the rest are shared team config) ───
SNOWFLAKE_ACCOUNT=<SNOWFLAKE_ACCOUNT>
SNOWFLAKE_USER=YOUR_SNOWFLAKE_USER     # e.g. <SNOWFLAKE_USER>
SNOWFLAKE_ROLE=<SNOWFLAKE_ROLE>
SNOWFLAKE_WAREHOUSE=<SNOWFLAKE_WAREHOUSE>

# ── Export target + behavior (shared) ────────────────────────────────────────
S3_BUCKET=s3://<S3_BUCKET>/idr_bulk/
WATERMARK_COLUMN=IDR_UPDT_TS
PAT_SECRET_ID=idr2/snowflake-pat       # Secrets Manager secret NAME (per account)
